# Standard dotenv for ASD_AGENT API keys. Never commit real values.
# Copy to  secrets.env  in the project root (any *.env file is git-ignored; check with
#   git check-ignore -v secrets.env
# ) or set the variables in your session instead:  $env:NVIDIA_API_KEY = '...'
# Then pass it explicitly:  --cohere-key-file secrets.env --nvidia-key-file secrets.env
# NOTE: the existing ".env" in this folder is a Continue YAML config, not a dotenv file.

# Query embedding (only needed for questions that are not cached yet)
COHERE_API_KEY=
# NVIDIA NIM reader (only needed for questions that are not cached yet)
NVIDIA_API_KEY=
