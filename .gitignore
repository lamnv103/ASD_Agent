# --- Secrets: never commit ---
# Any *.env file anywhere (e.g. secrets.env, deployments/database.env); *.env.example stays tracked.
*.env
.env
.env.*
!.env.example
!*.env.example
secrets/
continue*.yaml
*.pem
*.key

# --- Local environments / build artefacts ---
.venv*/
__pycache__/
*.pyc
.pytest_cache/

# --- Local database backups (large, regenerable with tasks.ps1 db-backup) ---
backups/

# --- Interrupted atomic writes ---
**/.pending-*

# --- Verification outputs (regenerable from tagged code + data) ---
reports/verification_runs/
